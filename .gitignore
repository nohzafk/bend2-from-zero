# An upstream clone, not our code (most of those 108 MB)
bend/

# Local conventions (papercut log, etc.): ignored here through ~/.config/git/ignore, which a fresh clone does not have.
.agents/

# mdBook build output
book/

# ---- bend build output ----
#
# `bend x.bend -o NAME` writes two files:
#   NAME       the host executable (CPU)
#   NAME.gpu   the MetalLib kernel, written only when the program uses `!`
# `bend x.bend -o NAME.c` writes the C intermediate that clang turns into
#
# the host side. NAME has no extension, and no glob can express "no extension",
# so the three directories that produce binaries use a whitelist: ignore
# everything in them, then name the sources back. The rule, in one line:
#
#     here, only *.md / *.bend / *.py are source.
#
# **A new probe never has to come back and edit this file.** Build products are
# ignored for free; a third kind of source (say .json) needs a line here.

life/*
!life/*.bend
!life/*.md
!life/*.py

parallel/*
!parallel/*.bend
!parallel/*.md

gpu/*
!gpu/*.bend
!gpu/*.md
# gpu/ has two subdirectories. The gpu/* above ignores the directories
# themselves, and git will not re-include a file under an ignored parent --
# so let the directories through, then their contents get the same whitelist.
!gpu/mandelbrot
!gpu/queens
gpu/mandelbrot/*
!gpu/mandelbrot/*.bend
!gpu/mandelbrot/*.md
# main.c is generated, but the book quotes and links it, so it ships
!gpu/mandelbrot/*.c
gpu/queens/*
!gpu/queens/*.bend
!gpu/queens/*.md
!gpu/queens/*.c

# Python bytecode from tools/drift
__pycache__/

# fx/ — effects probes. Same whitelist idea as the dirs above: only sources,
# builds ignored. The custom-effect dir also keeps .c and .js (the host files).
fx/*
!fx/*.md
!fx/io
!fx/custom
!fx/file
!fx/tcp
!fx/lane
fx/io/*
!fx/io/*.bend
!fx/io/*.md
fx/custom/*
!fx/custom/*.bend
!fx/custom/*.c
!fx/custom/*.js
!fx/custom/*.md
fx/file/*
!fx/file/*.bend
!fx/file/*.md
fx/tcp/*
!fx/tcp/*.bend
!fx/tcp/*.md
fx/lane/*
!fx/lane/*.bend
!fx/lane/*.md
